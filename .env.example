# ---- Browser-safe (bundled into the frontend) --------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# ---- Server-only: Netlify Functions + CLI scripts. NEVER prefix with VITE_ ----
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Random 32+ character string used to sign tutor session cookies
TUTOR_SESSION_SECRET=generate-with-openssl-rand-base64-48
# Random 16+ character pepper mixed into tutor-code hashes (keep stable; changing it invalidates all codes)
TUTOR_CODE_PEPPER=generate-with-openssl-rand-base64-32
# Optional tuning (defaults shown)
# TUTOR_SESSION_MAX_HOURS=4
# TUTOR_SESSION_IDLE_MINUTES=60
# Local plain-http development only:
# TUTOR_COOKIE_INSECURE=true
