{
  "name": "apu-tutorial-attendance",
  "private": true,
  "version": "1.0.0",
  "description": "APU Tutorial Attendance Management System (SDM & ISWE) – React + Vite on Netlify, Supabase backend",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:netlify": "netlify dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "bash supabase/tests/run_local.sh",
    "test:e2e": "bash tests/e2e/run.sh",
    "codes:generate": "tsx scripts/generate-tutor-codes.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "import:roster": "tsx scripts/import-roster.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "read-excel-file": "^9.3.10"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
